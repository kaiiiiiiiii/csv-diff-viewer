{
  "name": "csv-diff-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:wasm && vite build",
    "build:wasm": "cd src-wasm && ./build.sh --release",
    "build:wasm:dev": "cd src-wasm && ./build.sh --dev",
    "check": "prettier --write . && eslint --fix",
    "dev": "vite dev --port 3000",
    "dev:wasm": "npm run build:wasm:dev && vite dev --port 3000",
    "format": "prettier",
    "lint": "eslint",
    "serve": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
