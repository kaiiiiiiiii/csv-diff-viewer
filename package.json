    "@tanstack/router-plugin": "^1.168.45",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "nitro": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-fullscreen-crossbrowser": "^1.1.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
